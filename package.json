{
  "name": "code-recognition",
  "version": "1.0.0",
  "description": "Automatically recognize SiYuan code block languages with a fast local model",
  "main": "./src/index.ts",
  "scripts": {
    "format": "dprint fmt",
    "format:check": "dprint check",
    "lint": "eslint . --fix --cache",
    "dev": "webpack --config webpack.config.js --mode development",
    "build": "webpack --config webpack.config.js --mode production",
    "build:wasm": "node scripts/build-wasm.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test tests/*.test.cjs",
    "push": "git push origin HEAD --tags"
  },
  "keywords": [
    "siyuan",
    "code",
    "language-detection"
  ],
  "author": "Jeffrey Chen",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.4",
    "dprint": "^0.55.2",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "mini-css-extract-plugin": "^2.10.2",
    "sass": "^1.102.0",
    "sass-loader": "^17.0.0",
    "siyuan": "1.2.7",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "webpack": "^5.109.2",
    "webpack-cli": "^7.2.2",
    "zip-webpack-plugin": "^4.0.3"
  }
}
